import mc_chunk as chunk

// Minecraft World: manages loaded chunk columns.
//
// Usage:
//   import mc_world as world
//   var w = world.new(-64)
//   w = world.load_chunk(w, 0, 0, chunk_data, 24)!
//   let state_id = world.get_block(w, 10, 64, 20)

type World = {
  chunks: Map[String, chunk.ChunkColumn],
  min_y: Int,
}

fn new(min_y: Int) -> World = { chunks: map.new(), min_y: min_y }

fn chunk_key(cx: Int, cz: Int) -> String = "${int.to_string(cx)},${int.to_string(cz)}"

effect fn load_chunk(w: World, cx: Int, cz: Int, data: Bytes, num_sections: Int) -> World = {
  var col = chunk.parse_column(data, num_sections)!
  let col_final = { ...col, x: cx, z: cz, min_y: w.min_y }
  { ...w, chunks: map.set(w.chunks, chunk_key(cx, cz), col_final) }
}

fn unload_chunk(w: World, cx: Int, cz: Int) -> World =
  { ...w, chunks: map.remove(w.chunks, chunk_key(cx, cz)) }

fn get_chunk(w: World, cx: Int, cz: Int) -> Option[chunk.ChunkColumn] =
  map.get(w.chunks, chunk_key(cx, cz))

fn get_block(w: World, x: Int, y: Int, z: Int) -> Int = {
  let cx = if x >= 0 then x / 16 else (x + 1) / 16 - 1
  let cz = if z >= 0 then z / 16 else (z + 1) / 16 - 1
  let local_x = ((x % 16) + 16) % 16
  let local_z = ((z % 16) + 16) % 16
  match get_chunk(w, cx, cz) {
    some(col) => chunk.get_block(col, local_x, y, local_z),
    none => 0,
  }
}

fn set_block(w: World, x: Int, y: Int, z: Int, state_id: Int) -> World = {
  let cx = if x >= 0 then x / 16 else (x + 1) / 16 - 1
  let cz = if z >= 0 then z / 16 else (z + 1) / 16 - 1
  let local_x = ((x % 16) + 16) % 16
  let local_z = ((z % 16) + 16) % 16
  match get_chunk(w, cx, cz) {
    some(col) => {
      let new_col = chunk.set_block(col, local_x, y, local_z, state_id)
      { ...w, chunks: map.set(w.chunks, chunk_key(cx, cz), new_col) }
    },
    none => w,
  }
}

fn loaded_chunks(w: World) -> List[String] = map.keys(w.chunks)
fn chunk_count(w: World) -> Int = list.len(map.keys(w.chunks))

// ── Tests ───────────────────────────────────────

test "new world" {
  let w = new(-64)
  assert_eq(chunk_count(w), 0)
}

test "load and get chunk" {
  var w = new(-64)
  let col = chunk.empty_column(24)
  w = { ...w, chunks: map.set(w.chunks, chunk_key(0, 0), { ...col, min_y: -64 }) }
  assert_eq(chunk_count(w), 1)
  match get_chunk(w, 0, 0) {
    some(_) => assert(true),
    none => assert(false),
  }
}

test "unload chunk" {
  var w = new(-64)
  let col = chunk.empty_column(24)
  w = { ...w, chunks: map.set(w.chunks, chunk_key(0, 0), col) }
  w = unload_chunk(w, 0, 0)
  assert_eq(chunk_count(w), 0)
}

test "get block from empty world returns 0" {
  let w = new(-64)
  assert_eq(get_block(w, 100, 64, 200), 0)
}

test "set and get block world coords" {
  var w = new(-64)
  let col = chunk.empty_column(24)
  w = { ...w, chunks: map.set(w.chunks, chunk_key(0, 0), { ...col, min_y: -64 }) }
  w = set_block(w, 5, 64, 10, 42)
  assert_eq(get_block(w, 5, 64, 10), 42)
}
